# .env file for ADO Migration and other environment variables
# Lines starting with # are comments and will be ignored
# Format: VARIABLE_NAME=value (no spaces around =)

# Personal Access Tokens for Azure DevOps migration
# Replace these placeholder values with your actual tokens

# SOURCE PROJECT
MigrationTools__Endpoints__Source__Authentication__AccessToken=
MigrationTools__Endpoints__Source__Collection=
MigrationTools__Endpoints__Source__Project=

# TARGET PROJECT
MigrationTools__Endpoints__Target__Authentication__AccessToken=
MigrationTools__Endpoints__Target__Collection=
MigrationTools__Endpoints__Target__Project=